[Unit]
Description=FieldFab FastAPI backend
After=network.target

[Service]
User=futilediploma
Group=futilediploma
WorkingDirectory=/home/futilediploma/SprinkSync/fieldfab/backend
EnvironmentFile=-/home/futilediploma/SprinkSync/fieldfab/backend/.env
ExecStart=/home/futilediploma/SprinkSync/fieldfab/backend/venv/bin/uvicorn main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
