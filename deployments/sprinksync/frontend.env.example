# SprinkSync frontend environment template.
# Copy this to a real frontend env file during deployment. Do not commit real env files.

VITE_APP_BRAND=SprinkSync
VITE_APP_INSTANCE=sprinksync
VITE_API_BASE_URL=/api
VITE_AUTH_STORAGE_KEY=sprinksync_token

VITE_ENABLE_MANPOWER=true
VITE_ENABLE_FIELD_FAB=false
VITE_ENABLE_SCHEDULE_EXTRACTOR=false
