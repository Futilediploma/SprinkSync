# SprinkSync backend environment template.
# Copy this to a real .env on the server. Do not commit real .env files.

APP_BRAND=SprinkSync
APP_INSTANCE=sprinksync
APP_ENV=production
HOST=127.0.0.1
PORT=8002
LOG_DIR=/opt/sprinksync/logs

DATABASE_URL=sqlite:////opt/sprinksync/data/manpower_forecast.db

FRONTEND_URLS=https://sprinksync.com,https://www.sprinksync.com

SECRET_KEY=<unique-sprinksync-secret>
JWT_SECRET_KEY=<unique-sprinksync-jwt-secret-if-used>
SESSION_SECRET=<unique-sprinksync-session-secret-if-used>
COOKIE_NAME=sprinksync_session

EMAIL_PROVIDER=postmark
EMAIL_FROM=notifications@sprinksync.com
POSTMARK_API_KEY=<postmark-token>
RESEND_API_KEY=<resend-token>
EXPORT_COMPANY_NAME=SprinkSync

ENABLE_MANPOWER=true
ENABLE_FIELD_FAB=false
ENABLE_SCHEDULE_EXTRACTOR=false

NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_POLL_INTERVAL_SECONDS=60

SHAREPOINT_SYNC_ENABLED=false
SHAREPOINT_FILE_REMOTE_PATH=
SHAREPOINT_LOCAL_PATH=/opt/sprinksync/data/pipeline_tracker.xlsx
