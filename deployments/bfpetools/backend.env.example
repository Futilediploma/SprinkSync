# BFPE Tools backend environment template.
# Copy this to a real .env on the server. Do not commit real .env files.

APP_BRAND=BFPE Tools
APP_INSTANCE=bfpetools
APP_ENV=production
HOST=127.0.0.1
PORT=8001
LOG_DIR=/opt/bfpetools/logs

DATABASE_URL=sqlite:////opt/bfpetools/data/manpower_forecast.db

FRONTEND_URLS=https://bfpetools.com,https://www.bfpetools.com

SECRET_KEY=<unique-bfpetools-secret>
JWT_SECRET_KEY=<unique-bfpetools-jwt-secret-if-used>
SESSION_SECRET=<unique-bfpetools-session-secret-if-used>
COOKIE_NAME=bfpetools_session

EMAIL_PROVIDER=postmark
EMAIL_FROM=notifications@bfpetools.com
POSTMARK_API_KEY=<postmark-token>
RESEND_API_KEY=<resend-token>
EXPORT_COMPANY_NAME=BFPE Tools

ENABLE_MANPOWER=true
ENABLE_FIELD_FAB=false
ENABLE_SCHEDULE_EXTRACTOR=false

NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_POLL_INTERVAL_SECONDS=60

SHAREPOINT_SYNC_ENABLED=false
SHAREPOINT_FILE_REMOTE_PATH=
SHAREPOINT_LOCAL_PATH=/opt/bfpetools/data/pipeline_tracker.xlsx
